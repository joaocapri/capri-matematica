  "objetivos": [
    "Escolher a técnica de fatoração adequada a cada expressão",
    "Fatorar diferenças de quadrados e trinômios quadrados perfeitos",
    "Simplificar frações algébricas"
  ],
  "teoria": [
    {
      "titulo": "Fatorar é desfazer a multiplicação",
      "paragrafos": [
        "Fatorar é escrever uma expressão como produto. É o caminho inverso dos produtos notáveis e a base para simplificar frações e resolver equações.",
        "O primeiro passo é sempre procurar um fator comum a todos os termos e colocá-lo em evidência."
      ],
      "formulas": [
        "ax+ay=a(x+y)"
      ],
      "exemplo": {
        "enunciado": "Fatore 6x² + 9x.",
        "passos": [
          "O fator comum de 6 e 9 é 3; de x² e x é x.",
          "Coloque 3x em evidência: 3x(2x + 3).",
          "Confira distribuindo: 6x² + 9x."
        ]
      },
      "dica": "Confira sempre a fatoração multiplicando de volta. Leva poucos segundos."
    },
    {
      "titulo": "Os casos que mais caem",
      "paragrafos": [
        "Agrupamento: separe os termos em pares com fator comum. Diferença de quadrados: dois quadrados com sinal de menos entre eles. Trinômio quadrado perfeito: dois quadrados e o dobro do produto das raízes."
      ],
      "formulas": [
        "a^2-b^2=(a+b)(a-b)",
        "a^2\\pm2ab+b^2=(a\\pm b)^2",
        "ax+ay+bx+by=(a+b)(x+y)"
      ],
      "exemplo": {
        "enunciado": "Fatore x² − 10x + 25.",
        "passos": [
          "x² e 25 são quadrados de x e 5.",
          "O termo do meio é 2·x·5 = 10x, com sinal de menos.",
          "Logo, x² − 10x + 25 = (x − 5)²."
        ]
      },
      "erroComum": "x² + 9 não é diferença de quadrados e não se fatora nos reais."
    },
    {
      "titulo": "Simplificando frações algébricas",
      "paragrafos": [
        "Para simplificar, fatore numerador e denominador e cancele apenas fatores iguais, nunca parcelas."
      ],
      "exemplo": {
        "enunciado": "Simplifique (x² − 9)/(x + 3), com x ≠ −3.",
        "passos": [
          "Fatore o numerador: (x + 3)(x − 3).",
          "Cancele o fator x + 3.",
          "Resultado: x − 3."
        ]
      },
      "erroComum": "Em (x + 3)/3 não se pode cortar o 3: ele é parcela, não fator."
    }
  ],
