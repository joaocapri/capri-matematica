  "objetivos": [
    "Reconhecer dízimas periódicas",
    "Encontrar a fração geratriz de dízimas simples",
    "Encontrar a fração geratriz de dízimas compostas"
  ],
  "teoria": [
    {
      "titulo": "Dízimas simples",
      "paragrafos": [
        "Uma dízima periódica simples tem o período logo após a vírgula, como 0,333... ou 0,1212... A geratriz tem o período no numerador e, no denominador, um 9 para cada algarismo do período."
      ],
      "formulas": [
        "0{,}\\overline{12}=\\dfrac{12}{99}"
      ],
      "exemplo": {
        "enunciado": "Encontre a geratriz de 0,777...",
        "passos": [
          "Período 7, de um algarismo.",
          "7/9."
        ]
      },
      "dica": "Toda dízima periódica é um número racional: sempre vira fração."
    },
    {
      "titulo": "Dízimas compostas",
      "paragrafos": [
        "Na dízima composta há uma parte que não se repete antes do período, como 0,1666... Use o método da equação: chame a dízima de x e multiplique por potências de 10 para que as partes repetidas se cancelem."
      ],
      "exemplo": {
        "enunciado": "Encontre a geratriz de 0,1666...",
        "passos": [
          "x = 0,1666...; 10x = 1,666...; 100x = 16,666...",
          "100x − 10x = 15 ⇒ 90x = 15.",
          "x = 15/90 = 1/6."
        ]
      },
      "erroComum": "Esquecer a parte inteira: 2,333... é 2 + 3/9 = 7/3."
    }
  ],
