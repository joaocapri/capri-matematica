  "teoria": [
    {
      "titulo": "A ideia central",
      "paragrafos": [
        "Tangente é sen/cos, definida quando cos≠0. Secante é o inverso do cosseno e cossecante, o inverso do seno, respeitando seus domínios."
      ],
      "formulas": [
        "\\tan\\theta=\\frac{\\sin\\theta}{\\cos\\theta},\\quad\\sin^2\\theta+\\cos^2\\theta=1"
      ],
      "dica": "A relação fundamental costuma ser mais rápida que desenhar triângulo para ângulos gerais.",
      "erroComum": "Tangente não existe em π/2+kπ."
    },
    {
      "titulo": "Veja funcionando",
      "paragrafos": [
        "Vamos aplicar o conceito sem pular etapas."
      ],
      "exemplo": {
        "enunciado": "Se senθ=3/5 e θ está no QI, calcule cosθ e tanθ.",
        "passos": [
          "cos²=1−9/25=16/25 ⇒ cos=4/5.",
          "tan=(3/5)/(4/5)=3/4."
        ]
      }
    }
  ],
  "quiz": [
