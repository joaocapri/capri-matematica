  "objetivos": [
    "Somar e subtrair frações com o MMC",
    "Multiplicar e dividir frações",
    "Resolver problemas com fração de fração"
  ],
  "teoria": [
    {
      "titulo": "Soma e subtração",
      "paragrafos": [
        "Só se somam frações com o mesmo denominador. Se forem diferentes, reescreva com um denominador comum, de preferência o MMC."
      ],
      "formulas": [
        "\\dfrac{a}{b}+\\dfrac{c}{d}=\\dfrac{ad+bc}{bd}"
      ],
      "exemplo": {
        "enunciado": "Calcule 1/4 + 5/6.",
        "passos": [
          "MMC de 4 e 6: 12.",
          "3/12 + 10/12 = 13/12."
        ]
      },
      "erroComum": "Somar numeradores e denominadores: 1/4 + 5/6 não é 6/10."
    },
    {
      "titulo": "Multiplicação e divisão",
      "paragrafos": [
        "Para multiplicar, numerador com numerador e denominador com denominador. Para dividir, mantenha a primeira e multiplique pelo inverso da segunda."
      ],
      "formulas": [
        "\\dfrac{a}{b}\\div\\dfrac{c}{d}=\\dfrac{a}{b}\\cdot\\dfrac{d}{c}"
      ],
      "exemplo": {
        "enunciado": "Gastei 1/3 do salário com aluguel e 1/4 do que sobrou com comida. Que fração do salário foi para a comida?",
        "passos": [
          "Sobrou 2/3.",
          "1/4 de 2/3 = 2/12 = 1/6.",
          "Comida: 1/6 do salário."
        ]
      },
      "dica": "A palavra “de” entre frações significa multiplicação."
    }
  ],
