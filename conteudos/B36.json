  "teoria": [
    {
      "titulo": "Pegue a ideia",
      "paragrafos": [
        "O volume da esfera mede o espaço ocupado por ela. Fatiamentos como calotas e cunhas exigem identificar altura ou ângulo; o volume inteiro é uma boa referência para conferir o resultado."
      ],
      "formulas": [
        "V=\\frac43\\pi r^3"
      ],
      "dica": "Quando o enunciado falar em diâmetro, divida por 2 antes de substituir.",
      "erroComum": "Não esqueça o cubo do raio: volume escala em r³."
    },
    {
      "titulo": "Na prática",
      "paragrafos": [
        "Agora aplique o conceito em um exemplo resolvido."
      ],
      "exemplo": {
        "enunciado": "Esfera com raio 3: volume?",
        "passos": [
          "r³=27.",
          "V=(4/3)π·27=36π."
        ]
      }
    }
  ],
  "quiz": [
