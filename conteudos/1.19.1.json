  "teoria": [
    {
      "titulo": "Número binomial",
      "paragrafos": [
        "O número binomial (n sobre p) é o número de combinações de n elementos tomados p a p. Binomiais complementares são iguais."
      ],
      "formulas": [
        "\\binom{n}{p}=\\dfrac{n!}{p!\\,(n-p)!}",
        "\\binom{n}{p}=\\binom{n}{n-p}"
      ],
      "exemplo": {
        "enunciado": "Calcule (7 sobre 2) e (7 sobre 5).",
        "passos": [
          "(7 sobre 2) = 7 · 6/2 = 21.",
          "(7 sobre 5) é complementar: também 21."
        ]
      }
    },
    {
      "titulo": "Triângulo de Pascal",
      "paragrafos": [
        "No triângulo de Pascal, cada número é a soma dos dois acima dele (relação de Stifel). A soma dos números da linha n é 2ⁿ."
      ],
      "formulas": [
        "\\binom{n}{p}+\\binom{n}{p+1}=\\binom{n+1}{p+1}",
        "\\sum_{p=0}^{n}\\binom{n}{p}=2^n"
      ],
      "dica": "A linha n começa e termina com 1 e é simétrica.",
      "erroComum": "Começar a contar as linhas por 1. A primeira linha é a linha 0."
    }
  ],
