  "teoria": [
    {
      "titulo": "A ideia central",
      "paragrafos": [
        "Matriz inversa desfaz a multiplicação: AA⁻¹=I. Para matriz quadrada 2×2, determinante ad−bc; ela é inversível apenas quando determinante é diferente de zero."
      ],
      "formulas": [
        "\\det\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix}=ad-bc"
      ],
      "dica": "O determinante é um número; a inversa é outra matriz.",
      "erroComum": "Determinante zero indica matriz singular, sem inversa."
    },
    {
      "titulo": "Veja funcionando",
      "paragrafos": [
        "Vamos aplicar o conceito sem pular etapas."
      ],
      "exemplo": {
        "enunciado": "Calcule det [[2,1],[3,4]].",
        "passos": [
          "Det=2·4−1·3=8−3=5.",
          "Como 5≠0, a matriz é inversível."
        ]
      }
    }
  ],
