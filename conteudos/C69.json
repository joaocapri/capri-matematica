  ],
  "teoria": [
    {
      "titulo": "Tangente",
      "paragrafos": [
        "A tangente é o seno dividido pelo cosseno. No ciclo, ela é lida no eixo vertical que toca o ciclo no ponto (1, 0). Não existe quando o cosseno é zero: em 90° e 270°."
      ],
      "formulas": [
        "\\operatorname{tg}x=\\dfrac{\\operatorname{sen}x}{\\cos x}"
      ],
      "exemplo": {
        "enunciado": "Calcule tg 135°.",
        "passos": [
          "sen 135° = √2/2 e cos 135° = −√2/2.",
          "tg 135° = −1."
        ]
      },
      "dica": "A tangente é positiva no 1º e no 3º quadrantes."
    },
    {
      "titulo": "As outras três",
      "paragrafos": [
        "Secante, cossecante e cotangente são os inversos de cosseno, seno e tangente."
      ],
      "formulas": [
        "\\sec x=\\dfrac{1}{\\cos x}",
        "\\operatorname{cossec}x=\\dfrac{1}{\\operatorname{sen}x}",
        "\\operatorname{cotg}x=\\dfrac{\\cos x}{\\operatorname{sen}x}"
      ],
      "exemplo": {
        "enunciado": "Calcule sec 60° e cossec 30°.",
        "passos": [
          "sec 60° = 1/(1/2) = 2.",
          "cossec 30° = 1/(1/2) = 2."
        ]
      },
      "erroComum": "Confundir secante com o inverso do seno. Secante vai com cosseno."
    }
  ],
