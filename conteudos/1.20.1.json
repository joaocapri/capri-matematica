  "teoria": [
    {
      "titulo": "O desenvolvimento",
      "paragrafos": [
        "Os coeficientes de (a + b)ⁿ são os números da linha n do triângulo de Pascal. O expoente de a desce de n até 0 e o de b sobe de 0 até n."
      ],
      "formulas": [
        "(a+b)^n=\\sum_{p=0}^{n}\\binom{n}{p}a^{n-p}b^{p}"
      ],
      "exemplo": {
        "enunciado": "Desenvolva (x + 2)³.",
        "passos": [
          "Linha 3: 1, 3, 3, 1.",
          "x³ + 3 · x² · 2 + 3 · x · 4 + 8.",
          "x³ + 6x² + 12x + 8."
        ]
      }
    },
    {
      "titulo": "Termo geral",
      "paragrafos": [
        "O termo de ordem p + 1 é dado pela fórmula abaixo. Para achar o termo independente, iguale o expoente de x a zero."
      ],
      "formulas": [
        "T_{p+1}=\\binom{n}{p}a^{n-p}b^{p}"
      ],
      "exemplo": {
        "enunciado": "Encontre o termo independente de (x + 1/x)⁶.",
        "passos": [
          "T = (6 sobre p) · x^(6 − p) · x^(−p) = (6 sobre p) · x^(6 − 2p).",
          "6 − 2p = 0 ⇒ p = 3.",
          "Termo: (6 sobre 3) = 20."
        ]
      },
      "dica": "A soma dos coeficientes é o valor do binômio com x = 1.",
      "erroComum": "Esquecer de elevar o coeficiente de b: em (x + 2)³, o último termo é 2³ = 8."
    }
  ],
