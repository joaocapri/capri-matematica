  "teoria": [
    {
      "titulo": "Entenda a lógica",
      "paragrafos": [
        "Nas inequações logarítmicas, primeiro garanta argumentos positivos. Com base>1, a comparação entre argumentos mantém o sinal; com base entre 0 e 1, inverte."
      ],
      "formulas": [
        "\\log_a u>\\log_a v\\Longleftrightarrow u>v\\quad(a>1;\\ u,v>0)"
      ],
      "dica": "A resposta final deve ser a interseção entre domínio e inequação.",
      "erroComum": "Não use monotonicidade crescente quando 0<a<1."
    },
    {
      "titulo": "Na prática, sem enrolação",
      "paragrafos": [
        "Vamos sair da teoria e aplicar a ideia a um caso de prova."
      ],
      "exemplo": {
        "enunciado": "Resolva log₁/₂(x−1)>log₁/₂3.",
        "passos": [
          "Domínio: x−1>0 ⇒ x>1.",
          "Base 1/2 é decrescente: x−1<3.",
          "Conclusão: 1<x<4."
        ]
      }
    }
  ],
