  "teoria": [
    {
      "titulo": "O formato",
      "paragrafos": [
        "Em notação científica, o número é escrito como a · 10ⁿ, com 1 ≤ a < 10 e n inteiro. Números grandes têm n positivo; números pequenos, n negativo."
      ],
      "formulas": [
        "a\\cdot10^n,\\quad1\\le a<10"
      ],
      "exemplo": {
        "enunciado": "Escreva 0,00045 e 320 000 em notação científica.",
        "passos": [
          "0,00045 = 4,5 · 10⁻⁴.",
          "320 000 = 3,2 · 10⁵."
        ]
      },
      "dica": "Conte quantas casas a vírgula andou: para a esquerda o expoente é positivo; para a direita, negativo."
    },
    {
      "titulo": "Contas e ordem de grandeza",
      "paragrafos": [
        "Para multiplicar, multiplique os números e some os expoentes de 10; depois ajuste para que a fique entre 1 e 10. A ordem de grandeza é a potência de 10 mais próxima do número."
      ],
      "exemplo": {
        "enunciado": "Calcule (3 · 10⁵) · (4 · 10⁻²).",
        "passos": [
          "3 · 4 = 12 e 10⁵ · 10⁻² = 10³.",
          "12 · 10³ = 1,2 · 10⁴."
        ]
      },
      "erroComum": "Deixar a resposta como 12 · 10³. O número da frente precisa ficar entre 1 e 10."
    }
  ],
