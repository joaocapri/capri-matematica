  "objetivos": [
    "Ler e escrever números decimais",
    "Operar com decimais",
    "Converter decimais em frações e vice-versa"
  ],
  "teoria": [
    {
      "titulo": "Casas decimais",
      "paragrafos": [
        "Cada casa depois da vírgula vale um décimo da anterior: décimos, centésimos, milésimos. Por isso 0,25 = 25/100 = 1/4."
      ],
      "exemplo": {
        "enunciado": "Escreva 0,375 como fração irredutível.",
        "passos": [
          "0,375 = 375/1000.",
          "Divida por 125: 3/8."
        ]
      },
      "dica": "Para multiplicar por 10, 100 ou 1000, ande a vírgula 1, 2 ou 3 casas para a direita."
    },
    {
      "titulo": "Operações",
      "paragrafos": [
        "Na soma e subtração, alinhe as vírgulas. Na multiplicação, multiplique sem vírgula e depois conte as casas decimais dos fatores. Na divisão, iguale as casas e corte as vírgulas."
      ],
      "exemplo": {
        "enunciado": "Calcule 2,5 · 0,4 e 7,2 ÷ 0,06.",
        "passos": [
          "25 · 4 = 100, com duas casas: 1,00 = 1.",
          "7,20 ÷ 0,06 = 720 ÷ 6 = 120."
        ]
      },
      "erroComum": "Esquecer de contar as casas na multiplicação: 0,3 · 0,2 é 0,06, não 0,6."
    }
  ],
