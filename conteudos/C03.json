  "teoria": [
    {
      "titulo": "Entenda sem decorar",
      "paragrafos": [
        "Fração representa uma parte de um todo dividido em partes iguais, ou uma divisão. Para somar denominadores diferentes, precisamos reescrever as frações em partes de mesmo tamanho."
      ],
      "formulas": [
        "\\frac ab+\\frac cd=\\frac{ad+bc}{bd}\\quad(bd\\neq0)"
      ],
      "dica": "Antes de multiplicar frações, procure fatores que possam ser simplificados.",
      "erroComum": "Nunca some numerador e denominador separadamente."
    },
    {
      "titulo": "Hora de ver funcionar",
      "paragrafos": [
        "Vamos transformar a ideia em um exemplo resolvido."
      ],
      "exemplo": {
        "enunciado": "Calcule 1/2+1/3.",
        "passos": [
          "MMC dos denominadores 2 e 3 é 6.",
          "1/2=3/6 e 1/3=2/6.",
          "Total 5/6."
        ]
      }
    }
  ],
