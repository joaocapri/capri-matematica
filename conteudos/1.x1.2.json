  "teoria": [
    {
      "titulo": "Entenda sem decorar",
      "paragrafos": [
        "Juros compostos são multiplicativos: a cada período, a taxa incide sobre o montante atualizado. É uma progressão geométrica."
      ],
      "formulas": [
        "M=C(1+i)^n"
      ],
      "dica": "Taxas compostas sucessivas usam fatores multiplicativos.",
      "erroComum": "10% por dois meses não equivale exatamente a 20%: equivale a 21%."
    },
    {
      "titulo": "Hora de ver funcionar",
      "paragrafos": [
        "Vamos transformar a ideia em um exemplo resolvido."
      ],
      "exemplo": {
        "enunciado": "Aplique R$ 1000 a 10% ao mês por 2 meses.",
        "passos": [
          "Após mês 1: 1000·1,1=1100.",
          "Após mês 2: 1100·1,1=1210."
        ]
      }
    }
  ],
