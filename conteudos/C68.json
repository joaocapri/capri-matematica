  "objetivos": [
    "Reduzir arcos ao 1º quadrante",
    "Usar as simetrias do ciclo",
    "Calcular seno e cosseno de qualquer arco notável"
  ],
  "teoria": [
    {
      "titulo": "Simetrias",
      "paragrafos": [
        "Todo arco tem um correspondente no 1º quadrante com o mesmo seno e cosseno em módulo. Só muda o sinal, que depende do quadrante."
      ],
      "formulas": [
        "\\operatorname{sen}(180^\\circ-x)=\\operatorname{sen}x",
        "\\cos(180^\\circ-x)=-\\cos x",
        "\\operatorname{sen}(180^\\circ+x)=-\\operatorname{sen}x",
        "\\cos(360^\\circ-x)=\\cos x"
      ],
      "exemplo": {
        "enunciado": "Calcule sen 150°.",
        "passos": [
          "150° está no 2º quadrante: 180° − 30°.",
          "O seno é positivo no 2º quadrante.",
          "sen 150° = sen 30° = 1/2."
        ]
      }
    },
    {
      "titulo": "Passo a passo",
      "paragrafos": [
        "1) Veja o quadrante. 2) Encontre o ângulo de referência (distância até o eixo horizontal mais próximo). 3) Pegue o valor do ângulo de referência. 4) Coloque o sinal do quadrante."
      ],
      "exemplo": {
        "enunciado": "Calcule cos 240°.",
        "passos": [
          "3º quadrante: 240° = 180° + 60°.",
          "cos 60° = 1/2.",
          "No 3º quadrante o cosseno é negativo: −1/2."
        ]
      },
      "erroComum": "Esquecer o sinal no final."
    }
  ],
