  "teoria": [
    {
      "titulo": "Soma e subtração",
      "paragrafos": [
        "Some ou subtraia os coeficientes dos termos de mesmo grau. O grau da soma é no máximo o maior dos graus, e pode cair se os termos de maior grau se cancelarem."
      ],
      "exemplo": {
        "enunciado": "Calcule (3x² − x + 4) − (x² + 2x − 1).",
        "passos": [
          "3x² − x² = 2x².",
          "−x − 2x = −3x.",
          "4 − (−1) = 5. Resultado: 2x² − 3x + 5."
        ]
      },
      "erroComum": "Esquecer de trocar o sinal de todos os termos do polinômio que está sendo subtraído."
    },
    {
      "titulo": "Multiplicação",
      "paragrafos": [
        "Multiplique cada termo de um polinômio por todos os termos do outro e junte os termos semelhantes. O grau do produto é a soma dos graus."
      ],
      "formulas": [
        "\\operatorname{gr}(P\\cdot Q)=\\operatorname{gr}P+\\operatorname{gr}Q"
      ],
      "exemplo": {
        "enunciado": "Calcule (x + 2)(x² − x + 3).",
        "passos": [
          "x · (x² − x + 3) = x³ − x² + 3x.",
          "2 · (x² − x + 3) = 2x² − 2x + 6.",
          "Soma: x³ + x² + x + 6."
        ]
      }
    }
  ],
