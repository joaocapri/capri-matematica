  "objetivos": [
    "Resolver |x| < a e |x| > a",
    "Resolver inequações com expressões dentro do módulo",
    "Interpretar a solução como distância"
  ],
  "teoria": [
    {
      "titulo": "Miolo e caudas",
      "paragrafos": [
        "|x| < a quer dizer que x está a menos de a do zero: é o miolo da reta. |x| > a quer dizer que x está longe do zero: são as duas caudas."
      ],
      "formulas": [
        "|x|<a\\;\\Leftrightarrow\\;-a<x<a\\quad(a>0)",
        "|x|>a\\;\\Leftrightarrow\\;x<-a\\ \\text{ou}\\ x>a"
      ],
      "exemplo": {
        "enunciado": "Resolva |3 − 2x| ≤ 1.",
        "passos": [
          "−1 ≤ 3 − 2x ≤ 1.",
          "−4 ≤ −2x ≤ −2.",
          "Dividindo por −2 e invertendo: 1 ≤ x ≤ 2."
        ]
      },
      "dica": "Leia |x − 3| ≤ 4 como “x está a no máximo 4 de distância do 3”.",
      "erroComum": "Escrever |x| > a como −a > x > a. As caudas são duas desigualdades ligadas por “ou”."
    },
    {
      "titulo": "Casos especiais",
      "paragrafos": [
        "Se a for negativo, |x| < a não tem solução, e |x| > a vale para todo x. Módulo nunca é negativo."
      ],
      "exemplo": {
        "enunciado": "Resolva |x − 1| ≤ −1.",
        "passos": [
          "O módulo nunca é menor que zero.",
          "S = ∅."
        ]
      }
    }
  ],
