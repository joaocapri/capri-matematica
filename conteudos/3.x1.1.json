    {
      "titulo": "Pegue a ideia",
      "paragrafos": [
        "Elipse reúne pontos cuja soma das distâncias a dois focos é constante. Centro na origem, eixo maior horizontal: a²>b² e c²=a²−b². Excentricidade e=c/a fica entre 0 e 1."
      ],
      "formulas": [
        "\\frac{x^2}{a^2}+\\frac{y^2}{b^2}=1,\\quad c^2=a^2-b^2"
      ],
      "dica": "Denominador maior revela direção do eixo maior na forma canônica.",
      "erroComum": "Elipse não é hipérbole: os sinais entre os termos quadráticos são iguais."
    },
    {
      "titulo": "Na prática",
      "paragrafos": [
        "Agora aplique o conceito em um exemplo resolvido."
      ],
      "exemplo": {
        "enunciado": "Elipse x²/25+y²/9=1: semieixos e focos?",
        "passos": [
          "a=5,b=3.",
          "c²=25−9=16 ⇒ c=4.",
          "Focos (−4,0) e (4,0)."
        ]
      }
    }
  ],
