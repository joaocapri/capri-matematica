  "teoria": [
    {
      "titulo": "Tempo e massa",
      "paragrafos": [
        "Tempo não é decimal: 1 h = 60 min e 1 min = 60 s. Por isso 1,5 h é 1 h 30 min, e não 1 h 50 min. Na massa, 1 t = 1000 kg e 1 kg = 1000 g."
      ],
      "exemplo": {
        "enunciado": "Escreva 2,25 h em horas e minutos.",
        "passos": [
          "0,25 h = 0,25 · 60 = 15 min.",
          "2 h 15 min."
        ]
      },
      "erroComum": "Ler 1,5 h como 1 h 50 min."
    },
    {
      "titulo": "Velocidade e vazão",
      "paragrafos": [
        "Para converter km/h em m/s, divida por 3,6; de m/s para km/h, multiplique por 3,6. Vazão é volume por tempo, por exemplo litros por minuto."
      ],
      "formulas": [
        "1\\,\\text{m/s}=3{,}6\\,\\text{km/h}"
      ],
      "exemplo": {
        "enunciado": "Uma torneira despeja 12 L/min. Em quanto tempo enche um tanque de 1,8 m³?",
        "passos": [
          "1,8 m³ = 1800 L.",
          "1800/12 = 150 min.",
          "2 h 30 min."
        ]
      }
    }
  ],
