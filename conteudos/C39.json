  "teoria": [
    {
      "titulo": "A ideia central",
      "paragrafos": [
        "Arco duplo é um caso particular das fórmulas de adição quando os dois ângulos são iguais. Para cosseno, existem três formas equivalentes conforme a informação dada."
      ],
      "formulas": [
        "\\sin2x=2\\sin x\\cos x,\\quad\\cos2x=1-2\\sin^2x"
      ],
      "dica": "Use cos2x=2cos²x−1 quando só conhecer cosseno.",
      "erroComum": "sen2x não é 2senx."
    },
    {
      "titulo": "Veja funcionando",
      "paragrafos": [
        "Vamos aplicar o conceito sem pular etapas."
      ],
      "exemplo": {
        "enunciado": "Se senx=3/5 e cosx=4/5, calcule sen2x.",
        "passos": [
          "sen2x=2·(3/5)·(4/5)=24/25."
        ]
      }
    }
  ],
  "quiz": [
