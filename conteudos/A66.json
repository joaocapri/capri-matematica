  "teoria": [
    {
      "titulo": "Soma e produto",
      "paragrafos": [
        "Some partes reais com partes reais e imaginárias com imaginárias. Para multiplicar, use a distributiva e substitua i² por −1."
      ],
      "formulas": [
        "(a+bi)(c+di)=(ac-bd)+(ad+bc)i"
      ],
      "exemplo": {
        "enunciado": "Calcule (2 + 3i)(1 − i).",
        "passos": [
          "2 − 2i + 3i − 3i².",
          "2 + i + 3 (pois −3i² = 3).",
          "Resultado: 5 + i."
        ]
      }
    },
    {
      "titulo": "Conjugado e divisão",
      "paragrafos": [
        "O conjugado de z = a + bi é z̄ = a − bi. O produto z · z̄ = a² + b² é sempre real. Para dividir, multiplique numerador e denominador pelo conjugado do denominador."
      ],
      "formulas": [
        "z\\cdot\\bar z=a^2+b^2"
      ],
      "exemplo": {
        "enunciado": "Calcule (3 + i)/(1 + i).",
        "passos": [
          "Multiplique em cima e embaixo por 1 − i.",
          "Numerador: (3 + i)(1 − i) = 3 − 3i + i − i² = 4 − 2i. Denominador: 1 + 1 = 2.",
          "Resultado: 2 − i."
        ]
      },
      "erroComum": "Esquecer que i² = −1 e deixar o termo i² na resposta."
    }
  ],
