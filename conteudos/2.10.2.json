  "objetivos": [
    "Resolver inequações logarítmicas",
    "Inverter a desigualdade para bases entre 0 e 1",
    "Fazer a interseção com a condição de existência"
  ],
  "teoria": [
    {
      "titulo": "Dois cuidados",
      "paragrafos": [
        "Primeiro, a condição de existência: o logaritmando precisa ser positivo. Segundo, o sentido: com base maior que 1 a desigualdade se mantém; com base entre 0 e 1 ela se inverte.",
        "A solução final é a interseção do que sai da inequação com a condição de existência."
      ],
      "formulas": [
        "a>1:\\;\\log_a x>\\log_a y\\Leftrightarrow x>y>0",
        "0<a<1:\\;\\log_a x>\\log_a y\\Leftrightarrow 0<x<y"
      ],
      "exemplo": {
        "enunciado": "Resolva log₃(2x − 1) ≥ 2.",
        "passos": [
          "Existência: 2x − 1 > 0 ⇒ x > 1/2.",
          "2x − 1 ≥ 3² = 9 ⇒ x ≥ 5.",
          "Interseção: x ≥ 5."
        ]
      }
    },
    {
      "titulo": "Base menor que 1",
      "paragrafos": [
        "Com base entre 0 e 1, inverta o sentido e não esqueça a existência."
      ],
      "exemplo": {
        "enunciado": "Resolva log₁/₃ x > 2.",
        "passos": [
          "Existência: x > 0.",
          "Inverte: x < (1/3)² = 1/9.",
          "S = ]0, 1/9[."
        ]
      },
      "erroComum": "Resolver só a desigualdade e esquecer que x precisa ser positivo."
    }
  ],
