  "teoria": [
    {
      "titulo": "Entenda sem decorar",
      "paragrafos": [
        "Combinação seleciona grupos sem distinguir a ordem. A fórmula divide pela permutação interna do grupo, pois trocar posições não cria nova equipe."
      ],
      "formulas": [
        "C(n,p)=\\frac{n!}{p!(n-p)!}"
      ],
      "dica": "Quando escolher p e escolher n−p são processos complementares, use C(n,p)=C(n,n−p).",
      "erroComum": "Se cargos diferentes são atribuídos, provavelmente não é combinação simples."
    },
    {
      "titulo": "Hora de ver funcionar",
      "paragrafos": [
        "Vamos transformar a ideia em um exemplo resolvido."
      ],
      "exemplo": {
        "enunciado": "Escolha 2 representantes entre 5 alunos.",
        "passos": [
          "São pares, ordem não importa.",
          "C(5,2)=5·4/2=10."
        ]
      }
    }
  ],
