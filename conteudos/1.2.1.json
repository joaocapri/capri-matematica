  ],
  "teoria": [
    {
      "titulo": "Propriedades",
      "paragrafos": [
        "Com a mesma base, na multiplicação somam-se os expoentes e na divisão subtraem-se. Potência de potência multiplica os expoentes."
      ],
      "formulas": [
        "a^m\\cdot a^n=a^{m+n}",
        "\\dfrac{a^m}{a^n}=a^{m-n}",
        "(a^m)^n=a^{mn}"
      ],
      "exemplo": {
        "enunciado": "Simplifique 2⁶ · 4³ / 8⁴.",
        "passos": [
          "Escreva tudo em base 2: 2⁶ · 2⁶ / 2¹².",
          "2¹² / 2¹² = 1."
        ]
      },
      "erroComum": "Somar expoentes de bases diferentes: 2³ · 3² não é 6⁵."
    },
    {
      "titulo": "Expoentes especiais",
      "paragrafos": [
        "Todo número não nulo elevado a zero vale 1. Expoente negativo inverte a base. Expoente fracionário é raiz."
      ],
      "formulas": [
        "a^0=1",
        "a^{-n}=\\dfrac{1}{a^n}",
        "a^{p/q}=\\sqrt[q]{a^p}"
      ],
      "exemplo": {
        "enunciado": "Calcule 8^(2/3) + 2⁻².",
        "passos": [
          "8^(2/3) = (∛8)² = 4.",
          "2⁻² = 1/4.",
          "Soma: 17/4."
        ]
      }
    }
  ],
