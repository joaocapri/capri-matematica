  "teoria": [
    {
      "titulo": "Ordem 2",
      "paragrafos": [
        "O determinante de uma matriz 2 × 2 é o produto da diagonal principal menos o produto da diagonal secundária."
      ],
      "formulas": [
        "\\begin{vmatrix}a&b\\\\c&d\\end{vmatrix}=ad-bc"
      ],
      "exemplo": {
        "enunciado": "Calcule o determinante de [[3, −2], [4, 5]].",
        "passos": [
          "3 · 5 − (−2) · 4.",
          "15 + 8 = 23."
        ]
      }
    },
    {
      "titulo": "Regra de Sarrus",
      "paragrafos": [
        "Para ordem 3, repita as duas primeiras colunas à direita. Some os três produtos das diagonais que descem para a direita e subtraia os três produtos das que sobem."
      ],
      "exemplo": {
        "enunciado": "Calcule det [[1, 2, 0], [3, 1, 2], [0, 1, 4]].",
        "passos": [
          "Descendo: 1·1·4 + 2·2·0 + 0·3·1 = 4.",
          "Subindo: 0·1·0 + 1·2·1 + 4·3·2 = 2 + 24 = 26.",
          "det = 4 − 26 = −22."
        ]
      },
      "dica": "Sarrus só vale para ordem 3. Para ordem maior, use Laplace.",
      "erroComum": "Esquecer de subtrair as diagonais secundárias inteiras, com o sinal de cada produto."
    }
  ],
