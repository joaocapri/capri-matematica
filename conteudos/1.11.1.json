  "teoria": [
    {
      "titulo": "Comprimento, área e volume",
      "paragrafos": [
        "No comprimento, cada unidade é 10 vezes a seguinte (km, hm, dam, m, dm, cm, mm). Na área, como são duas dimensões, o fator é 100. No volume, com três dimensões, é 1000."
      ],
      "formulas": [
        "1\\,\\text{m}^2=10\\,000\\,\\text{cm}^2",
        "1\\,\\text{m}^3=1\\,000\\,000\\,\\text{cm}^3"
      ],
      "exemplo": {
        "enunciado": "Quantos cm² há em 2,5 m²?",
        "passos": [
          "1 m² = 100 cm · 100 cm = 10 000 cm².",
          "2,5 · 10 000 = 25 000 cm²."
        ]
      },
      "erroComum": "Usar fator 10 em área: 1 m² não é 100 cm², é 10 000 cm²."
    },
    {
      "titulo": "Capacidade",
      "paragrafos": [
        "Capacidade é o volume em litros. A ligação é: 1 litro = 1 dm³ e 1 m³ = 1000 litros."
      ],
      "formulas": [
        "1\\,\\text{L}=1\\,\\text{dm}^3",
        "1\\,\\text{m}^3=1000\\,\\text{L}"
      ],
      "exemplo": {
        "enunciado": "Uma caixa d’água tem 2 m × 1,5 m × 1 m. Quantos litros cabem?",
        "passos": [
          "V = 3 m³.",
          "3 · 1000 = 3000 L."
        ]
      },
      "dica": "Converta todas as medidas para decímetros e o volume já sai em litros."
    }
  ],
