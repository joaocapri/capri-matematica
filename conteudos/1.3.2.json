  "teoria": [
    {
      "titulo": "Raiz quadrada no denominador",
      "paragrafos": [
        "Racionalizar é tirar a raiz do denominador. Com uma raiz quadrada, multiplique em cima e embaixo por ela mesma."
      ],
      "formulas": [
        "\\dfrac{a}{\\sqrt b}=\\dfrac{a\\sqrt b}{b}"
      ],
      "exemplo": {
        "enunciado": "Racionalize 6/√3.",
        "passos": [
          "6√3/3.",
          "2√3."
        ]
      }
    },
    {
      "titulo": "O conjugado",
      "paragrafos": [
        "Com √a + √b ou √a − √b no denominador, multiplique pelo conjugado (troque o sinal do meio). O produto vira uma diferença de quadrados, sem raízes."
      ],
      "formulas": [
        "(\\sqrt a+\\sqrt b)(\\sqrt a-\\sqrt b)=a-b"
      ],
      "exemplo": {
        "enunciado": "Racionalize 1/(√5 − √3).",
        "passos": [
          "Multiplique por √5 + √3.",
          "Denominador: 5 − 3 = 2.",
          "(√5 + √3)/2."
        ]
      },
      "erroComum": "Multiplicar só o denominador. Numerador e denominador precisam ser multiplicados pelo mesmo número."
    }
  ],
