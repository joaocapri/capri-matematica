// Publicação no Cloudflare (Workers com arquivos estáticos).
// O site é estático: não há build. O Cloudflare copia o repositório e publica a cada push no main.
{
  "name": "capri-matematica",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    // Endereço que não existe abre o site (o app escolhe a página), como fazia o Cloudflare Pages.
    "not_found_handling": "single-page-application"
  }
}
